root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false

# Ruby (Jekyll plugins)
[*.rb]
indent_size = 2

# YAML (Jekyll config & data)
[*.{yml,yaml}]
indent_size = 2

# HTML / Liquid
[*.{html,liquid}]
indent_size = 2

# CSS / Sass
[*.{css,scss,sass}]
indent_size = 2

# JavaScript
[*.js]
indent_size = 2

# JSON
[*.json]
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 2

# Makefiles
[Makefile]
indent_style = tab